xiaohongshu = type=http-response, pattern=^https:\/\/edith\.xiaohongshu\.com\/api\/sns\/v1\/note\/(imagefeed|live_photo\/save), script-path=https://raw.githubusercontent.com/lalifeier/Shadowrocket/main/QuanX/Scripts/xiaohongshu.js, requires-body=true, max-size=-1, timeout=60
